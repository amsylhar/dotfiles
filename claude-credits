#!/usr/bin/env bash
# claude-credits — Check if Claude Code credit usage is on pace with the weekly cycle
#                  Credits reset every Thursday at 17:00 (configurable)
#
# Usage: claude-credits [0-100]
#        Without argument, reads the cache written by the status line.
#        The status line must be installed (see claude-statusline-install.sh).
#
# Config (env vars):
#   CLAUDE_RESET_DOW   Day of week for reset (ISO: 1=Mon … 7=Sun). Default: 4 (Thu)
#   CLAUDE_RESET_HOUR  Hour of reset (0-23). Default: 17
set -euo pipefail

CACHE="${HOME}/.claude/credits-cache"
RESET_DOW="${CLAUDE_RESET_DOW:-4}"
RESET_HOUR="${CLAUDE_RESET_HOUR:-17}"

# ── Colors ────────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    RED='\033[0;31m'  YLW='\033[0;33m'  GRN='\033[0;32m'
    CYN='\033[0;36m'  BLD='\033[1m'     DIM='\033[2m'     RST='\033[0m'
else
    RED='' YLW='' GRN='' CYN='' BLD='' DIM='' RST=''
fi

# ── Get usage % ───────────────────────────────────────────────────────────────
if [[ $# -eq 1 ]]; then
    if [[ ! $1 =~ ^[0-9]+$ ]] || [[ $1 -gt 100 ]]; then
        printf "Usage: claude-credits [0-100]\n" >&2; exit 1
    fi
    USED=$1
    SOURCE="manual"
elif [[ -f "$CACHE" ]]; then
    USED=$(awk '{printf "%.0f", $1}' "$CACHE")
    SOURCE="cache"
else
    printf "\n  ${YLW}No data.${RST} Open Claude Code to update the cache, or pass the value:\n"
    printf "  claude-credits 40\n\n"
    exit 1
fi

# ── Cycle position (reset_day 17:00 → reset_day 17:00) ───────────────────────
DOW=$(date +%u)
H=$(date +%-H)
M=$(date +%-M)

NOW_S=$(( (DOW-1)*86400 + H*3600 + M*60 ))
RST_S=$(( (RESET_DOW-1)*86400 + RESET_HOUR*3600 ))
CYCLE_S=$(( 7*86400 ))

if (( NOW_S >= RST_S )); then
    ELP_S=$(( NOW_S - RST_S ))
else
    ELP_S=$(( CYCLE_S - RST_S + NOW_S ))
fi

REM_S=$(( CYCLE_S - ELP_S ))
ELP_PCT=$(( ELP_S * 100 / CYCLE_S ))
REM_H=$(( REM_S / 3600 ))
REM_D=$(( REM_H / 24 ))
REM_HR=$(( REM_H % 24 ))

# Next reset timestamp
NEXT_RST=$(date -d "+${REM_H} hours" '+%a %d %b  %H:%M' 2>/dev/null \
        || date -v "+${REM_H}H" '+%a %d %b  %H:%M' 2>/dev/null)

# ── Progress bar ──────────────────────────────────────────────────────────────
W=22
bar() {
    local pct=$1 col=$2 res="" i
    local filled=$(( pct * W / 100 ))
    for (( i=0; i<W; i++ )); do
        if (( i < filled )); then res+='█'; else res+='░'; fi
    done
    printf "%b%s%b" "$col" "$res" "$RST"
}

# ── Delta and verdict ─────────────────────────────────────────────────────────
DELTA=$(( USED - ELP_PCT ))

if   (( DELTA <   0 )); then VCOL=$GRN; UCOL=$GRN; VERDICT="▼  ${DELTA}%"
elif (( DELTA <=  5 )); then VCOL=$GRN; UCOL=$GRN; VERDICT="●  +${DELTA}%"
elif (( DELTA <= 15 )); then VCOL=$YLW; UCOL=$YLW; VERDICT="▲  +${DELTA}%"
else                          VCOL=$RED; UCOL=$RED; VERDICT="▲  +${DELTA}%"
fi

# ── Separator ─────────────────────────────────────────────────────────────────
SEP=""; for _ in {1..54}; do SEP+='─'; done

# ── Output ────────────────────────────────────────────────────────────────────
RESET_DAY_NAME=$(date -d "next thursday" '+%a' 2>/dev/null || echo "Thu")

printf "\n"
printf "  ${DIM}%s${RST}\n" "$SEP"
printf "  ${BLD}${CYN}  Claude Credits${RST}  ${DIM}·  weekly cycle (Thu %02d:00 → Thu %02d:00)${RST}\n" \
    "$RESET_HOUR" "$RESET_HOUR"
printf "  ${DIM}%s${RST}\n" "$SEP"
printf "\n"
printf "  Cycle  $(bar "$ELP_PCT" "$DIM")  ${BLD}%3d%%${RST}  ${DIM}%s${RST}\n" \
    "$ELP_PCT" "$(date '+%a %d %b  %H:%M')"
printf "  Usage  $(bar "$USED"    "$UCOL")  ${BLD}%3d%%${RST}  ${DIM}(%s)${RST}\n" \
    "$USED" "$SOURCE"
printf "\n"
printf "  ${VCOL}${BLD}%s${RST}\n" "$VERDICT"
printf "\n"
printf "  ${DIM}Next reset: %s  ·  %dd %dh${RST}\n" "$NEXT_RST" "$REM_D" "$REM_HR"
printf "  ${DIM}%s${RST}\n" "$SEP"
printf "\n"
